{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/v1/role-input.schema.json",
  "title": "Role Input Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "role",
    "factory_run_id",
    "stage_attempt_id",
    "invocation_id",
    "lifecycle_state",
    "stage_attempt_ordinal",
    "issued_at",
    "deadline_at",
    "wall_clock_limit_ms",
    "issue",
    "source",
    "instructions",
    "policy_refs",
    "prior_handoffs",
    "role_payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract": {
      "const": "role_input"
    },
    "role": {
      "enum": [
        "builder",
        "verifier",
        "reviewer"
      ]
    },
    "factory_run_id": {
      "type": "string",
      "pattern": "^fr_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "stage_attempt_id": {
      "type": "string",
      "pattern": "^fa_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^ri_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "lifecycle_state": {
      "enum": [
        "building",
        "verifying",
        "reviewing"
      ]
    },
    "stage_attempt_ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "issued_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "deadline_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "wall_clock_limit_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200000
    },
    "issue": {
      "$ref": "#/$defs/issue"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "instructions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "policy_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/policy_ref"
      }
    },
    "prior_handoffs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "role_payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "builder"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "building"
          },
          "source": {
            "$ref": "#/$defs/builder_source"
          },
          "role_payload": {
            "$ref": "#/$defs/builder_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "verifier"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "verifying"
          },
          "source": {
            "$ref": "#/$defs/candidate_source"
          },
          "role_payload": {
            "$ref": "#/$defs/verifier_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "reviewer"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "reviewing"
          },
          "source": {
            "$ref": "#/$defs/candidate_source"
          },
          "role_payload": {
            "$ref": "#/$defs/reviewer_payload"
          }
        }
      }
    }
  ],
  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "number",
        "title",
        "acceptance_criteria",
        "url",
        "created_at"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract",
        "factory_run_id",
        "candidate_ordinal",
        "builder_stage_attempt_id",
        "branch_ref",
        "base_sha",
        "head_commit_sha",
        "source_tree_sha"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "contract": {
          "const": "candidate_release"
        },
        "factory_run_id": {
          "type": "string",
          "pattern": "^fr_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "candidate_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "builder_stage_attempt_id": {
          "type": "string",
          "pattern": "^fa_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "branch_ref": {
          "type": "string",
          "pattern": "^refs/heads/[^ ]+$"
        },
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "head_commit_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "source_tree_sha": {
          "$ref": "#/$defs/git_sha"
        }
      }
    },
    "source": {
      "type": "object"
    },
    "builder_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree_path",
        "branch_ref",
        "base_sha",
        "candidate"
      ],
      "properties": {
        "worktree_path": {
          "type": "string",
          "minLength": 1
        },
        "branch_ref": {
          "type": "string",
          "pattern": "^refs/heads/[^ ]+$"
        },
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "candidate": {
          "type": "null"
        }
      }
    },
    "candidate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree_path",
        "branch_ref",
        "base_sha",
        "candidate"
      ],
      "properties": {
        "worktree_path": {
          "type": "string",
          "minLength": 1
        },
        "branch_ref": {
          "type": "string",
          "pattern": "^refs/heads/[^ ]+$"
        },
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        }
      }
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "builder_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "forbidden_paths",
        "validation_commands",
        "repair_brief"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "forbidden_paths": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "validation_commands": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "repair_brief": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verifier_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_commands",
        "changed_paths",
        "diff_sha256"
      ],
      "properties": {
        "required_commands": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "changed_paths": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "diff_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reviewer_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_paths",
        "diff_sha256",
        "risk_policy_id",
        "risk_policy_sha256"
      ],
      "properties": {
        "changed_paths": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "diff_sha256": {
          "$ref": "#/$defs/digest"
        },
        "risk_policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "risk_policy_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
